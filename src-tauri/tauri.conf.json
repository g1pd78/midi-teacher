{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDI Teacher",
  "version": "0.1.0",
  "identifier": "com.g1pd78.miditeacher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIDI Teacher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#15171C",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost mtsound: http://mtsound.localhost; media-src 'self' blob: mtsound: http://mtsound.localhost; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/soundfonts/*": "soundfonts/",
      "resources/gm/*": "gm/"
    },
    "copyright": "© 2026 mtanzella и участники проекта. Лицензия GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Обучение игре на фортепиано",
    "longDescription": "Интерактивный нотный стан, тренажёр чтения нот и разучивание пьес с MIDI-клавиатурой.",
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
